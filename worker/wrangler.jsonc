
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-diary-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",

  // D1 数据库绑定：本地开发走本地 SQLite
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-diary-local-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // R2 图片存储绑定
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "life-diary-local-images"
    }
  ],

  // 预览环境
  "env": {
    "preview": {
      "name": "life-diary-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "life-diary-preview-db",
          "database_id": "59ab4cd5-08ad-420a-a9e5-8dc7a86b251e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "life-diary-preview-images"
        }
      ]
    },

    // 正式环境
    "production": {
      "name": "life-diary",
      "vars": {
        "APP_ORIGIN": "https://cyccyc23cyc.dpdns.org"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "life-diary-production-db",
          "database_id": "902090d0-23d6-4aa6-b387-55fff2720763",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "life-diary-production-images"
        }
      ]
    }
  }
}
